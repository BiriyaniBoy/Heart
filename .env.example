# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
# (the public portfolio site + the admin dashboard)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:4000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/subhojit-portfolio

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=pf_admin_token

# Seed admin user (used once by `npm run seed:admin`)
ADMIN_NAME=Subhojit Das
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding

# Cloudinary (fill in later — see https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
