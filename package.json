{
  "name": "subhojit-portfolio-api",
  "version": "1.0.0",
  "description": "Backend API for Subhojit's portfolio — Express + MongoDB (Mongoose) + Cloudinary. Public read routes for the portfolio site, JWT-protected write routes for the admin app.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:content": "node scripts/seedContent.js",
    "seed:content:force": "node scripts/seedContent.js --force",
    "test:smoke": "node scripts/smokeTest.js"
  },
  "keywords": ["portfolio", "api", "express", "mongodb"],
  "author": "Subhojit Das",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "morgan": "^1.12.0",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14"
  }
}
